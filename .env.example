NETWORK=fuji
# Deployer: deploys contracts, acts as demo arbiter and demo client (needs Fuji AVAX)
DEPLOYER_PRIVATE_KEY=
# Demo freelancer wallet used by npm run seed
FREELANCER_PRIVATE_KEY=
# Optional
# ARBITER_ADDRESS=
# RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Optional private order messaging (Node 24+, no wallet private key required).
# Remains OFF on GitHub Pages/static exports.
COLLAB_ENABLED=false
# Set to the exact HTTPS origin of this Express service, without a path.
# PUBLIC_ORIGIN=https://your-approved-host.example
# Persistent private volume; never inside public/ or site/.
# COLLAB_DATA_DIR=/data/landed
